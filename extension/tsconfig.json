{
  "extends": [
    "@tsconfig/node-lts/tsconfig.json",
    "@tsconfig/strictest/tsconfig.json"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "chrome"]
  }
}
