NODE_ENV=development
# Production APP_ORIGIN is set in the deployment chart.
APP_ORIGIN=http://localhost:5173
# Production source: SSM /infra/bookmarker/cf-access-issuer
CF_ACCESS_ISSUER=https://access.example.invalid
# Production source: SSM /infra/bookmarker/cf-access-aud
CF_ACCESS_AUD=example-access-audience
DEV_AUTH_BYPASS=true

# Production source: SSM /infra/bookmarker/hatena-consumer-key
HATENA_CONSUMER_KEY=example-hatena-consumer-key
# Production source: SSM /infra/bookmarker/hatena-consumer-secret
HATENA_CONSUMER_SECRET=example-hatena-consumer-secret
# Production source: SSM /infra/bookmarker/hatena-access-token
HATENA_ACCESS_TOKEN=example-hatena-access-token
# Production source: SSM /infra/bookmarker/hatena-access-token-secret
HATENA_ACCESS_TOKEN_SECRET=example-hatena-access-token-secret

# Production source: SSM /infra/bookmarker/mastodon-base-url
MASTODON_BASE_URL=https://mastodon.example.invalid
# Production source: SSM /infra/bookmarker/mastodon-access-token
MASTODON_ACCESS_TOKEN=example-mastodon-access-token

# Production source: SSM /infra/bookmarker/raindrop-access-token
RAINDROP_ACCESS_TOKEN=example-raindrop-access-token

# Production source: Helm value
LITELLM_BASE_URL=http://litellm.example.invalid/v1
# Production source: SSM /infra/bookmarker/litellm-api-key
LITELLM_API_KEY=example-litellm-api-key
# Production source: Helm value
LITELLM_MODEL=vertex/example-model
