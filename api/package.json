    "hono": "4.13.13",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.2",
    "neverthrow": "8.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
